{
  "checking_policy_version": "2026-09-12.3",
  "schema_version": "gametestlab.game-task-plan.v1",
  "task_id": "target-rush",
  "title": "Target Rush",
  "difficulty": {
    "level": "D1",
    "rationale": "单一点击循环，状态少，但同时覆盖倒计时、错误点击和重开。"
  },
  "category": "action",
  "features": [],
  "environment": {
    "pages": 1,
    "fake_camera": false,
    "persistent_storage": false
  },
  "surface": "dom",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "selectors": {
    "score": "[data-testid='score']",
    "status": "[data-testid='status']",
    "surface": "#playfield"
  },
  "controls": [
    {
      "action_id": "START",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#start-btn"
    },
    {
      "action_id": "HIT",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#target"
    },
    {
      "action_id": "MISS",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "x_ratio": 0.08,
      "y_ratio": 0.92
    },
    {
      "action_id": "RESTART",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#restart-btn"
    },
    {
      "action_id": "RESTART_KEY",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "KeyR"
    }
  ],
  "requirements": [
    {
      "id": "TR-RUN",
      "layer": "L1",
      "severity": "must",
      "statement": "游戏可以进入 playing 状态且无运行错误。",
      "depends_on": [],
      "observable": [
        "status",
        "runtime"
      ]
    },
    {
      "id": "TR-HIT",
      "layer": "L2",
      "severity": "must",
      "statement": "每次目标点击只增加一分，五分获胜。",
      "depends_on": [
        "TR-RUN"
      ],
      "observable": [
        "score",
        "target_index",
        "events"
      ]
    },
    {
      "id": "TR-LOSE",
      "layer": "L2",
      "severity": "must",
      "statement": "三次 miss 或倒计时结束会失败。",
      "depends_on": [
        "TR-RUN"
      ],
      "observable": [
        "misses",
        "remaining_ms",
        "status"
      ]
    },
    {
      "id": "TR-RESET",
      "layer": "L2",
      "severity": "must",
      "statement": "重开恢复菜单和全部初始值。",
      "depends_on": [
        "TR-RUN"
      ],
      "observable": [
        "state",
        "game_reset"
      ]
    },
    {
      "id": "TR-HUD",
      "layer": "L3",
      "severity": "must",
      "statement": "HUD 可见且非空，胜负状态文字正确。分数含义和画面质量另行复核，不由非空检查认证。",
      "depends_on": [
        "TR-HIT"
      ],
      "observable": [
        "scoreText",
        "statusText"
      ]
    }
  ],
