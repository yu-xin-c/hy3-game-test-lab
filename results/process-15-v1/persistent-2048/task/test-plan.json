{
  "checking_policy_version": "2026-09-12.3",
  "schema_version": "gametestlab.game-task-plan.v1",
  "task_id": "persistent-2048",
  "title": "Persistent 2048",
  "difficulty": {
    "level": "D2",
    "rationale": "确定性合并规则与真实刷新后的存档一致性都需要验证。"
  },
  "category": "puzzle",
  "features": [
    "persistence"
  ],
  "environment": {
    "pages": 1,
    "fake_camera": false,
    "persistent_storage": true
  },
  "surface": "dom",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "selectors": {
    "score": "[data-testid='score']",
    "status": "[data-testid='status']",
    "surface": "#board"
  },
  "controls": [
    {
      "action_id": "START",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#start-btn"
    },
    {
      "action_id": "UP",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "ArrowUp"
    },
    {
      "action_id": "RIGHT",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "ArrowRight"
    },
    {
      "action_id": "DOWN",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "ArrowDown"
    },
    {
      "action_id": "RESTART",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#restart-btn"
    }
  ],
  "requirements": [
    {
      "id": "P2-RUN",
      "layer": "L1",
      "severity": "must",
      "statement": "游戏可以开始且无运行、资源或网络错误。",
      "depends_on": [],
      "observable": [
        "status",
        "runtime"
      ]
    },
    {
      "id": "P2-MAIN",
      "layer": "L2",
      "severity": "must",
      "statement": "滑动、合并和刷新恢复必须产生同一棋盘与步数。",
      "depends_on": [
        "P2-RUN"
      ],
      "observable": [
        "grid",
        "moves",
        "max_tile",
        "saved",
        "events"
      ]
    },
    {
      "id": "P2-LOSS",
      "layer": "L2",
      "severity": "must",
      "statement": "两步后没有 8 必须失败。",
      "depends_on": [
        "P2-RUN"
      ],
      "observable": [
        "status",
        "game_lost",
        "state"
      ]
    },
    {
      "id": "P2-RESET",
      "layer": "L2",
      "severity": "must",
      "statement": "Restart 清除存档并恢复原始棋盘和菜单。",
      "depends_on": [
        "P2-RUN"
      ],
      "observable": [
        "state",
        "game_reset"
      ]
    },
    {
      "id": "P2-HUD",
      "layer": "L3",
      "severity": "must",
      "statement": "HUD 可见且非空，胜负状态文字正确。分数含义和画面质量另行复核，不由非空检查认证。",
      "depends_on": [
        "P2-MAIN"
      ],
      "observable": [
        "scoreText",
        "statusText",
        "screenshot"
      ]
    }
  ],
