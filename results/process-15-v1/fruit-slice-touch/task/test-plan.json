{
  "checking_policy_version": "2026-09-12.3",
  "schema_version": "gametestlab.game-task-plan.v1",
  "task_id": "fruit-slice-touch",
  "title": "Fruit Slice Touch",
  "difficulty": {
    "level": "D1",
    "rationale": "触控目标、炸弹惩罚和明确终局可以直接复现。"
  },
  "category": "action",
  "features": [
    "touch"
  ],
  "environment": {
    "pages": 1,
    "fake_camera": false,
    "persistent_storage": false
  },
  "surface": "dom",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "selectors": {
    "score": "[data-testid='score']",
    "status": "[data-testid='status']",
    "surface": "#playfield"
  },
  "controls": [
    {
      "action_id": "START",
      "actor": "primary",
      "device": "touch",
      "key_event": "press",
      "selector": "#start-btn"
    },
    {
      "action_id": "SLICE",
      "actor": "primary",
      "device": "touch",
      "key_event": "press",
      "selector": "#fruit"
    },
    {
      "action_id": "BOMB",
      "actor": "primary",
      "device": "touch",
      "key_event": "press",
      "selector": "#bomb"
    },
    {
      "action_id": "RESTART",
      "actor": "primary",
      "device": "touch",
      "key_event": "press",
      "selector": "#restart-btn"
    }
  ],
  "requirements": [
    {
      "id": "FS-RUN",
      "layer": "L1",
      "severity": "must",
      "statement": "游戏可以开始且无运行、资源或网络错误。",
      "depends_on": [],
      "observable": [
        "status",
        "runtime"
      ]
    },
    {
      "id": "FS-MAIN",
      "layer": "L2",
      "severity": "must",
      "statement": "触控水果每次只计 10 分，切中五个水果获胜。",
      "depends_on": [
        "FS-RUN"
      ],
      "observable": [
        "score",
        "sliced",
        "remaining",
        "fruit_sliced"
      ]
    },
    {
      "id": "FS-LOSS",
      "layer": "L2",
      "severity": "must",
      "statement": "三次触碰炸弹会扣光生命并失败。",
      "depends_on": [
        "FS-RUN"
      ],
      "observable": [
        "status",
        "game_lost",
        "state"
      ]
    },
    {
      "id": "FS-RESET",
      "layer": "L2",
      "severity": "must",
      "statement": "Restart 返回菜单，恢复 0 分、3 条生命和 5 个剩余水果。",
      "depends_on": [
        "FS-RUN"
      ],
      "observable": [
        "state",
        "game_reset"
      ]
    },
    {
      "id": "FS-HUD",
      "layer": "L3",
      "severity": "must",
      "statement": "HUD 可见且非空，胜负状态文字正确。分数含义和画面质量另行复核，不由非空检查认证。",
      "depends_on": [
        "FS-MAIN"
      ],
      "observable": [
        "scoreText",
        "statusText",
        "screenshot"
      ]
    }
  ],
