{
  "checking_policy_version": "2026-09-12.3",
  "schema_version": "gametestlab.game-task-plan.v1",
  "task_id": "meteor-survivor",
  "title": "Meteor Survivor",
  "difficulty": {
    "level": "D2",
    "rationale": "固定时间波次、躲避输入和局内榜单需要同步计算。"
  },
  "category": "action",
  "features": [
    "leaderboard"
  ],
  "environment": {
    "pages": 1,
    "fake_camera": false,
    "persistent_storage": false
  },
  "surface": "canvas2d",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "selectors": {
    "score": "[data-testid='score']",
    "status": "[data-testid='status']",
    "surface": "#game-canvas"
  },
  "controls": [
    {
      "action_id": "START",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#start-btn"
    },
    {
      "action_id": "LEFT",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "ArrowLeft"
    },
    {
      "action_id": "RIGHT",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "ArrowRight"
    },
    {
      "action_id": "RESTART",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#restart-btn"
    }
  ],
  "requirements": [
    {
      "id": "MS-RUN",
      "layer": "L1",
      "severity": "must",
      "statement": "游戏可以开始且无运行、资源或网络错误。",
      "depends_on": [],
      "observable": [
        "status",
        "runtime"
      ]
    },
    {
      "id": "MS-MAIN",
      "layer": "L2",
      "severity": "must",
      "statement": "按固定波次躲避会推进 wave、score 和 best_score。",
      "depends_on": [
        "MS-RUN"
      ],
      "observable": [
        "lane",
        "elapsed_ms",
        "wave",
        "score",
        "best_score"
      ]
    },
    {
      "id": "MS-LOSS",
      "layer": "L2",
      "severity": "must",
      "statement": "玩家和流星同轨会立即失败且不能获得该波分数。",
      "depends_on": [
        "MS-RUN"
      ],
      "observable": [
        "status",
        "game_lost",
        "state"
      ]
    },
    {
      "id": "MS-RESET",
      "layer": "L2",
      "severity": "must",
      "statement": "Restart 清空当前局；新的评测场景从空榜单开始。",
      "depends_on": [
        "MS-RUN"
      ],
      "observable": [
        "state",
        "game_reset"
      ]
    },
    {
      "id": "MS-HUD",
      "layer": "L3",
      "severity": "must",
      "statement": "HUD 可见且非空，胜负状态文字正确。分数含义和画面质量另行复核，不由非空检查认证。",
      "depends_on": [
        "MS-MAIN"
      ],
      "observable": [
        "scoreText",
        "statusText",
        "screenshot"
      ]
    }
  ],
