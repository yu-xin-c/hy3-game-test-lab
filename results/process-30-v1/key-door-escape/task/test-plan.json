{
  "checking_policy_version": "2026-09-12.3",
  "schema_version": "gametestlab.game-task-plan.v1",
  "task_id": "key-door-escape",
  "title": "Key Door Escape",
  "difficulty": {
    "level": "D2",
    "rationale": "包含钥匙、锁门、生命和复活，多条规则必须保持一致。"
  },
  "category": "puzzle",
  "features": [],
  "environment": {
    "pages": 1,
    "fake_camera": false,
    "persistent_storage": false
  },
  "surface": "dom",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "selectors": {
    "score": "[data-testid='score']",
    "status": "[data-testid='status']",
    "surface": "#board"
  },
  "controls": [
    {
      "action_id": "START",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#start-btn"
    },
    {
      "action_id": "UP",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "ArrowUp"
    },
    {
      "action_id": "DOWN",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "ArrowDown"
    },
    {
      "action_id": "LEFT",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "ArrowLeft"
    },
    {
      "action_id": "RIGHT",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "ArrowRight"
    },
    {
      "action_id": "RESTART",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#restart-btn"
    },
    {
      "action_id": "RESTART_KEY",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "KeyR"
    }
  ],
  "requirements": [
    {
      "id": "KD-RUN",
      "layer": "L1",
      "severity": "must",
      "statement": "游戏可以进入 playing 状态且无运行错误。",
      "depends_on": [],
      "observable": [
        "status",
        "runtime"
      ]
    },
    {
      "id": "KD-DOOR",
      "layer": "L2",
      "severity": "must",
      "statement": "没有钥匙时门阻挡，取得钥匙后门可以打开。",
      "depends_on": [
        "KD-RUN"
      ],
      "observable": [
        "has_key",
        "door_open",
        "events"
      ]
    },
    {
      "id": "KD-TRAP",
      "layer": "L2",
      "severity": "must",
      "statement": "陷阱扣除生命并复活，生命归零失败。",
      "depends_on": [
        "KD-RUN"
      ],
      "observable": [
        "lives",
        "player",
        "events"
      ]
    },
    {
      "id": "KD-WIN",
      "layer": "L2",
      "severity": "must",
      "statement": "开门后进入出口获胜。",
      "depends_on": [
        "KD-DOOR"
      ],
      "observable": [
        "status",
        "game_won"
      ]
    },
    {
      "id": "KD-RESET",
      "layer": "L2",
      "severity": "must",
      "statement": "重开恢复生命、钥匙、门和玩家位置。",
      "depends_on": [
        "KD-RUN"
      ],
      "observable": [
        "state",
        "game_reset"
      ]
    },
    {
      "id": "KD-HUD",
      "layer": "L3",
      "severity": "must",
      "statement": "HUD 可见且非空，胜负状态文字正确。分数含义和画面质量另行复核，不由非空检查认证。",
      "depends_on": [
        "KD-DOOR"
      ],
      "observable": [
        "scoreText",
        "statusText"
      ]
    }
  ],
