{
  "name": "hy3-game-test-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Layered playtesting and first-failure localization for AI-generated browser games.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check:data": "tsx scripts/validate-dataset.ts",
    "build:game-tasks": "tsx scripts/build-distribution-game-tasks.ts",
    "prepare:codebuddy": "tsx scripts/prepare-codebuddy-batch.ts",
    "summarize:codebuddy": "tsx scripts/summarize-codebuddy-batch.ts",
    "export:codebuddy": "tsx scripts/export-codebuddy-evidence.ts",
    "record:codebuddy": "tsx scripts/record-codebuddy-generation.ts",
    "audit:codebuddy": "tsx scripts/audit-codebuddy-batch.ts",
    "run:codebuddy": "tsx scripts/run-codebuddy-batch.ts",
    "judge:codebuddy": "tsx scripts/judge-codebuddy-batch.ts",
    "report:codebuddy": "tsx scripts/report-full-batch.ts",
    "consolidate:results": "tsx scripts/consolidate-results.ts",
    "check:game-tasks": "tsx scripts/validate-game-tasks.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:all": "pnpm run test && pnpm run test:browser",
    "check": "pnpm run build && pnpm run check:data && pnpm run check:game-tasks && pnpm run test",
    "demo:serve": "tsx scripts/serve-demo.ts",
    "eval:sample": "tsx scripts/run-sample-eval.ts",
    "eval:task": "tsx scripts/evaluate-generated-task.ts",
    "eval:freeze": "tsx scripts/freeze-sample.ts",
    "eval:visual": "tsx scripts/judge-screenshot.ts",
    "hy3:probe": "tsx scripts/probe-hy3.ts",
    "hy3:generate": "tsx scripts/generate-game.ts",
    "hy3:plan": "tsx scripts/generate-plan.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.24.0"
}
