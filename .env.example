# Hy3 uses an OpenAI-compatible endpoint. The official self-hosted example is
# http://127.0.0.1:8000/v1 with API key EMPTY. Override all values for a
# managed endpoint. Never commit a real key.
HY3_BASE_URL=http://127.0.0.1:8000/v1
HY3_API_KEY=EMPTY
HY3_MODEL=hy3
HY3_REASONING_EFFORT=high

# Optional OpenAI-compatible multimodal judge used only by L3 semantic UI
# checks. If unset, L3 reports deterministic checks and marks semantic checks
# as unverified.
MULTIMODAL_BASE_URL=
MULTIMODAL_API_KEY=
MULTIMODAL_MODEL=

GAMETESTLAB_HOST=127.0.0.1
GAMETESTLAB_PORT=4173

