{
  "schema_version": "gametestlab.game-task-plan.v1",
  "task_id": "cube-rotation",
  "title": "Cube Rotation",
  "difficulty": {
    "level": "D3",
    "rationale": "围绕手势转魔方设置三段确定性路径，并覆盖错误输入和重开。"
  },
  "category": "puzzle",
  "features": [
    "3d",
    "camera"
  ],
  "environment": {
    "pages": 1,
    "fake_camera": true,
    "persistent_storage": false
  },
  "surface": "webgl",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "selectors": {
    "score": "[data-testid='score']",
    "status": "[data-testid='status']",
    "surface": "#game-canvas"
  },
  "controls": [
    {
      "action_id": "START",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#start-btn"
    },
    {
      "action_id": "STAGE_1",
      "actor": "primary",
      "device": "camera",
      "key_event": "press",
      "fixture_frame": "blue-left-marker"
    },
    {
      "action_id": "STAGE_2",
      "actor": "primary",
      "device": "camera",
      "key_event": "press",
      "fixture_frame": "green-center-marker"
    },
    {
      "action_id": "STAGE_3",
      "actor": "primary",
      "device": "camera",
      "key_event": "press",
      "fixture_frame": "yellow-right-marker"
    },
    {
      "action_id": "WRONG",
      "actor": "primary",
      "device": "camera",
      "key_event": "press",
      "fixture_frame": "red-cross-marker"
    },
    {
      "action_id": "RESTART",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#restart-btn"
    }
  ],
  "requirements": [
    {
      "id": "X039-RUN",
      "layer": "L1",
      "severity": "must",
      "statement": "游戏可以开始且无运行、资源或网络错误。",
      "depends_on": [],
      "observable": [
        "status",
        "runtime"
      ]
    },
    {
      "id": "X039-MAIN",
      "layer": "L2",
      "severity": "must",
      "statement": "手势转魔方的三个阶段必须按固定顺序推进进度和分数。",
      "depends_on": [
        "X039-RUN"
      ],
      "observable": [
        "progress",
        "score",
        "lives",
        "last_action",
        "events"
      ]
    },
    {
      "id": "X039-LOSS",
      "layer": "L2",
      "severity": "must",
      "statement": "两次错误操作会清空生命并失败。",
      "depends_on": [
        "X039-RUN"
      ],
      "observable": [
        "status",
        "game_lost",
        "state"
      ]
    },
    {
      "id": "X039-RESET",
      "layer": "L2",
      "severity": "must",
      "statement": "Restart 恢复0进度、0分、2条生命、空 last_action 和菜单。",
      "depends_on": [
        "X039-RUN"
      ],
      "observable": [
        "state",
        "game_reset"
      ]
    },
    {
      "id": "X039-HUD",
      "layer": "L3",
      "severity": "must",
      "statement": "HUD 的分数和状态必须与内部状态一致，关键画面在800×600视口内完整可见。",
      "depends_on": [
        "X039-MAIN"
      ],
      "observable": [
        "scoreText",
        "statusText",
        "screenshot"
      ]
    }
  ],
