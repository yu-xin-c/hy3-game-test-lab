{
  "schema_version": "gametestlab.game-task-plan.v1",
  "task_id": "gesture-goalie",
  "title": "Gesture Goalie",
  "difficulty": {
    "level": "D3",
    "rationale": "固定摄像头画面必须被识别成动作并正确驱动三轮守门。"
  },
  "category": "action",
  "features": [
    "camera"
  ],
  "environment": {
    "pages": 1,
    "fake_camera": true,
    "persistent_storage": false
  },
  "surface": "canvas2d",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "selectors": {
    "score": "[data-testid='score']",
    "status": "[data-testid='status']",
    "surface": "#game-canvas"
  },
  "controls": [
    {
      "action_id": "START",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#start-btn"
    },
    {
      "action_id": "SHOW_LEFT",
      "actor": "primary",
      "device": "camera",
      "key_event": "press",
      "fixture_frame": "left-pose"
    },
    {
      "action_id": "SHOW_CENTER",
      "actor": "primary",
      "device": "camera",
      "key_event": "press",
      "fixture_frame": "center-pose"
    },
    {
      "action_id": "SHOW_RIGHT",
      "actor": "primary",
      "device": "camera",
      "key_event": "press",
      "fixture_frame": "right-pose"
    },
    {
      "action_id": "RESTART",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#restart-btn"
    }
  ],
  "requirements": [
    {
      "id": "GG-RUN",
      "layer": "L1",
      "severity": "must",
      "statement": "游戏可以开始且无运行、资源或网络错误。",
      "depends_on": [],
      "observable": [
        "status",
        "runtime"
      ]
    },
    {
      "id": "GG-MAIN",
      "layer": "L2",
      "severity": "must",
      "statement": "固定摄像头帧必须识别为正确守门位置并推进射门。",
      "depends_on": [
        "GG-RUN"
      ],
      "observable": [
        "shot_index",
        "saves",
        "keeper_pose",
        "pose_detected"
      ]
    },
    {
      "id": "GG-LOSS",
      "layer": "L2",
      "severity": "must",
      "statement": "两次错误守门会扣光生命并失败。",
      "depends_on": [
        "GG-RUN"
      ],
      "observable": [
        "status",
        "game_lost",
        "state"
      ]
    },
    {
      "id": "GG-RESET",
      "layer": "L2",
      "severity": "must",
      "statement": "Restart 恢复第 0 球、0 次扑救、2 条生命和菜单。",
      "depends_on": [
        "GG-RUN"
      ],
      "observable": [
        "state",
        "game_reset"
      ]
    },
    {
      "id": "GG-HUD",
      "layer": "L3",
      "severity": "must",
      "statement": "HUD 的分数和状态必须与内部状态一致，关键画面在800×600视口内完整可见。",
      "depends_on": [
        "GG-MAIN"
      ],
      "observable": [
        "scoreText",
        "statusText",
        "screenshot"
      ]
    }
  ],
  "scenarios": [
