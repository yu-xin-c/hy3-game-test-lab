{
  "checking_policy_version": "2026-09-12.3",
  "schema_version": "gametestlab.game-task-plan.v1",
  "task_id": "cooperative-city",
  "title": "Cooperative City",
  "difficulty": {
    "level": "D3",
    "rationale": "两页协作、资源建设、双方确认和共享倒计时必须同步。"
  },
  "category": "simulation",
  "features": [
    "multiplayer"
  ],
  "environment": {
    "pages": 2,
    "fake_camera": false,
    "persistent_storage": false
  },
  "surface": "dom",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "selectors": {
    "score": "[data-testid='score']",
    "status": "[data-testid='status']",
    "surface": "#city"
  },
  "controls": [
    {
      "action_id": "START",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#start-btn"
    },
    {
      "action_id": "JOIN",
      "actor": "secondary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#join-btn"
    },
    {
      "action_id": "BUILD_POWER",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#power-btn"
    },
    {
      "action_id": "BUILD_WATER",
      "actor": "secondary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#water-btn"
    },
    {
      "action_id": "APPROVE_P1",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#approve-btn"
    },
    {
      "action_id": "APPROVE_P2",
      "actor": "secondary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#approve-btn"
    },
    {
      "action_id": "RESTART",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#restart-btn"
    }
  ],
  "requirements": [
    {
      "id": "CC-RUN",
      "layer": "L1",
      "severity": "must",
      "statement": "游戏可以开始且无运行、资源或网络错误。",
      "depends_on": [],
      "observable": [
        "status",
        "runtime"
      ]
    },
    {
      "id": "CC-MAIN",
      "layer": "L2",
      "severity": "must",
      "statement": "两个页面必须同步建设资源与确认状态，并在条件满足时同时结束。",
      "depends_on": [
        "CC-RUN"
      ],
      "observable": [
        "connected",
        "power",
        "water",
        "approvals",
        "elapsed_ms"
      ]
    },
    {
      "id": "CC-LOSS",
      "layer": "L2",
      "severity": "must",
      "statement": "10秒内协作未完成时两个页面必须同时失败。",
      "depends_on": [
        "CC-RUN"
      ],
      "observable": [
        "status",
        "game_lost",
        "state"
      ]
    },
    {
      "id": "CC-RESET",
      "layer": "L2",
      "severity": "must",
      "statement": "主页面 Restart 同步清空资源、确认、计时和连接并回到菜单。",
      "depends_on": [
        "CC-RUN"
      ],
      "observable": [
        "state",
        "game_reset"
      ]
    },
    {
      "id": "CC-HUD",
      "layer": "L3",
      "severity": "must",
      "statement": "HUD 可见且非空，胜负状态文字正确。分数含义和画面质量另行复核，不由非空检查认证。",
      "depends_on": [
        "CC-MAIN"
      ],
      "observable": [
        "scoreText",
        "statusText",
        "screenshot"
      ]
    }
  ],
