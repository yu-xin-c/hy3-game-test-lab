{
  "checking_policy_version": "2026-09-12.3",
  "schema_version": "gametestlab.game-task-plan.v1",
  "task_id": "sky-jump",
  "title": "Sky Jump",
  "difficulty": {
    "level": "D2",
    "rationale": "围绕云端跳跃设置三段确定性路径，并覆盖错误输入和重开。"
  },
  "category": "action",
  "features": [
    "touch"
  ],
  "environment": {
    "pages": 1,
    "fake_camera": false,
    "persistent_storage": false
  },
  "surface": "canvas2d",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "selectors": {
    "score": "[data-testid='score']",
    "status": "[data-testid='status']",
    "surface": "#game-canvas"
  },
  "controls": [
    {
      "action_id": "START",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#start-btn"
    },
    {
      "action_id": "STAGE_1",
      "actor": "primary",
      "device": "touch",
      "key_event": "press",
      "selector": "#stage-1"
    },
    {
      "action_id": "STAGE_2",
      "actor": "primary",
      "device": "touch",
      "key_event": "press",
      "selector": "#stage-2"
    },
    {
      "action_id": "STAGE_3",
      "actor": "primary",
      "device": "touch",
      "key_event": "press",
      "selector": "#stage-3"
    },
    {
      "action_id": "WRONG",
      "actor": "primary",
      "device": "touch",
      "key_event": "press",
      "selector": "#wrong-action"
    },
    {
      "action_id": "RESTART",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#restart-btn"
    }
  ],
  "requirements": [
    {
      "id": "X002-RUN",
      "layer": "L1",
      "severity": "must",
      "statement": "游戏可以开始且无运行、资源或网络错误。",
      "depends_on": [],
      "observable": [
        "status",
        "runtime"
      ]
    },
    {
      "id": "X002-MAIN",
      "layer": "L2",
      "severity": "must",
      "statement": "云端跳跃的三个阶段必须按固定顺序推进进度和分数。",
      "depends_on": [
        "X002-RUN"
      ],
      "observable": [
        "progress",
        "score",
        "lives",
        "last_action",
        "events"
      ]
    },
    {
      "id": "X002-LOSS",
      "layer": "L2",
      "severity": "must",
      "statement": "两次错误操作会清空生命并失败。",
      "depends_on": [
        "X002-RUN"
      ],
      "observable": [
        "status",
        "game_lost",
        "state"
      ]
    },
    {
      "id": "X002-RESET",
      "layer": "L2",
      "severity": "must",
      "statement": "Restart 恢复0进度、0分、2条生命、空 last_action 和菜单。",
      "depends_on": [
        "X002-RUN"
      ],
      "observable": [
        "state",
        "game_reset"
      ]
    },
    {
      "id": "X002-HUD",
      "layer": "L3",
      "severity": "must",
      "statement": "HUD 可见且非空，胜负状态文字正确。分数含义和画面质量另行复核，不由非空检查认证。",
      "depends_on": [
        "X002-MAIN"
      ],
      "observable": [
        "scoreText",
        "statusText",
        "screenshot"
      ]
    }
  ],
