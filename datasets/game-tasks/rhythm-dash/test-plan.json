{
  "schema_version": "gametestlab.game-task-plan.v1",
  "task_id": "rhythm-dash",
  "title": "Rhythm Dash",
  "difficulty": {
    "level": "D2",
    "rationale": "围绕节奏冲刺设置三段确定性路径，并覆盖错误输入和重开。"
  },
  "category": "action",
  "features": [],
  "environment": {
    "pages": 1,
    "fake_camera": false,
    "persistent_storage": false
  },
  "surface": "canvas2d",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "selectors": {
    "score": "[data-testid='score']",
    "status": "[data-testid='status']",
    "surface": "#game-canvas"
  },
  "controls": [
    {
      "action_id": "START",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#start-btn"
    },
    {
      "action_id": "STAGE_1",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "KeyA"
    },
    {
      "action_id": "STAGE_2",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "KeyS"
    },
    {
      "action_id": "STAGE_3",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "KeyD"
    },
    {
      "action_id": "WRONG",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "KeyX"
    },
    {
      "action_id": "RESTART",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#restart-btn"
    }
  ],
  "requirements": [
    {
      "id": "X013-RUN",
      "layer": "L1",
      "severity": "must",
      "statement": "游戏可以开始且无运行、资源或网络错误。",
      "depends_on": [],
      "observable": [
        "status",
        "runtime"
      ]
    },
    {
      "id": "X013-MAIN",
      "layer": "L2",
      "severity": "must",
      "statement": "节奏冲刺的三个阶段必须按固定顺序推进进度和分数。",
      "depends_on": [
        "X013-RUN"
      ],
      "observable": [
        "progress",
        "score",
        "lives",
        "last_action",
        "events"
      ]
    },
    {
      "id": "X013-LOSS",
      "layer": "L2",
      "severity": "must",
      "statement": "两次错误操作会清空生命并失败。",
      "depends_on": [
        "X013-RUN"
      ],
      "observable": [
        "status",
        "game_lost",
        "state"
      ]
    },
    {
      "id": "X013-RESET",
      "layer": "L2",
      "severity": "must",
      "statement": "Restart 恢复0进度、0分、2条生命、空 last_action 和菜单。",
      "depends_on": [
        "X013-RUN"
      ],
      "observable": [
        "state",
        "game_reset"
      ]
    },
    {
      "id": "X013-HUD",
      "layer": "L3",
      "severity": "must",
      "statement": "HUD 的分数和状态必须与内部状态一致，关键画面在800×600视口内完整可见。",
      "depends_on": [
        "X013-MAIN"
      ],
      "observable": [
        "scoreText",
        "statusText",
        "screenshot"
      ]
    }
  ],
  "scenarios": [
