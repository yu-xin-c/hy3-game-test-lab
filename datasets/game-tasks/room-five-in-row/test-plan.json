  "task_id": "room-five-in-row",
  "title": "Room Five in a Row",
  "difficulty": {
    "level": "D2",
    "rationale": "两个页面交替落子并同步棋盘、回合和胜负。"
  },
  "category": "puzzle",
  "features": [
    "multiplayer"
  ],
  "environment": {
