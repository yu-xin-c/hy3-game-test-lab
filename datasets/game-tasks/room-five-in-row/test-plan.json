    {
      "action_id": "RESTART",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#restart-btn"
    }
  ],
  "requirements": [
    {
      "id": "FR-RUN",
      "layer": "L1",
      "severity": "must",
      "statement": "游戏可以开始且无运行、资源或网络错误。",
      "depends_on": [],
      "observable": [
        "status",
        "runtime"
      ]
    },
    {
      "id": "FR-MAIN",
      "layer": "L2",
      "severity": "must",
      "statement": "两页棋盘、当前回合和落子结果必须同步，五连时立即结束。",
      "depends_on": [
        "FR-RUN"
      ],
      "observable": [
        "connected",
        "turn",
        "moves",
        "winner",
        "board"
      ]
    },
    {
      "id": "FR-LOSS",
      "layer": "L2",
      "severity": "must",
      "statement": "P2 先形成五连时主页面必须判负。",
      "depends_on": [
        "FR-RUN"
      ],
      "observable": [
        "status",
        "game_lost",
        "state"
      ]
    },
    {
      "id": "FR-RESET",
      "layer": "L2",
      "severity": "must",
      "statement": "主页面 Restart 同步清空棋盘、回合、步数和房间状态。",
      "depends_on": [
        "FR-RUN"
      ],
      "observable": [
        "state",
        "game_reset"
      ]
    },
    {
      "id": "FR-HUD",
      "layer": "L3",
      "severity": "must",
      "statement": "HUD 的分数和状态必须与内部状态一致，关键画面在800×600视口内完整可见。",
      "depends_on": [
        "FR-MAIN"
      ],
      "observable": [
        "scoreText",
        "statusText",
        "screenshot"
      ]
    }
  ],
