{
  "schema_version": "gametestlab.game-task-plan.v1",
  "task_id": "dual-arena",
  "title": "Dual Arena",
  "difficulty": {
    "level": "D3",
    "rationale": "两个页面必须同步房间、回合状态和同一个终局。"
  },
  "category": "action",
  "features": [
    "multiplayer"
  ],
  "environment": {
    "pages": 2,
    "fake_camera": false,
    "persistent_storage": false
  },
  "surface": "canvas2d",
  "viewport": {
    "width": 800,
    "height": 600
  },
  "selectors": {
    "score": "[data-testid='score']",
    "status": "[data-testid='status']",
    "surface": "#arena"
  },
  "controls": [
    {
      "action_id": "START",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#start-btn"
    },
    {
      "action_id": "JOIN",
      "actor": "secondary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#join-btn"
    },
    {
      "action_id": "P1_STEP",
      "actor": "primary",
      "device": "keyboard",
      "key_event": "press",
      "code": "KeyD"
    },
    {
      "action_id": "P2_STEP",
      "actor": "secondary",
      "device": "keyboard",
      "key_event": "press",
      "code": "KeyL"
    },
    {
      "action_id": "RESTART",
      "actor": "primary",
      "device": "mouse",
      "key_event": "press",
      "selector": "#restart-btn"
    }
  ],
  "requirements": [
    {
      "id": "DA-RUN",
      "layer": "L1",
      "severity": "must",
      "statement": "游戏可以开始且无运行、资源或网络错误。",
      "depends_on": [],
      "observable": [
        "status",
        "runtime"
      ]
    },
    {
      "id": "DA-MAIN",
      "layer": "L2",
      "severity": "must",
      "statement": "两个页面的连接、双方位置和胜者必须实时保持一致。",
      "depends_on": [
        "DA-RUN"
      ],
      "observable": [
        "connected",
        "p1_position",
        "p2_position",
        "winner",
        "events"
      ]
    },
    {
      "id": "DA-LOSS",
      "layer": "L2",
      "severity": "must",
      "statement": "副玩家先到终点时主页面必须判负。",
      "depends_on": [
        "DA-RUN"
      ],
      "observable": [
        "status",
        "game_lost",
        "state"
      ]
    },
    {
      "id": "DA-RESET",
      "layer": "L2",
      "severity": "must",
      "statement": "主页面 Restart 会同步清空双方位置和连接状态并回到菜单。",
      "depends_on": [
        "DA-RUN"
      ],
      "observable": [
        "state",
        "game_reset"
      ]
    },
    {
      "id": "DA-HUD",
      "layer": "L3",
      "severity": "must",
      "statement": "HUD 的分数和状态必须与内部状态一致，关键画面在800×600视口内完整可见。",
      "depends_on": [
        "DA-MAIN"
      ],
      "observable": [
        "scoreText",
        "statusText",
        "screenshot"
      ]
    }
  ],
  "scenarios": [
